# ---- Server ----
PORT=8001
HOST=0.0.0.0
PUBLIC_BASE_URL=http://18.204.127.179:8001

# ---- Storage ----
# gcs (production) | local (dev/testing)
STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=meet-cloud
GCS_PROJECT_ID=betacrmerp
GCS_LOCATION=ASIA-SOUTH1
GOOGLE_APPLICATION_CREDENTIALS=./Service-Account.json
SIGNED_URL_EXPIRES_DAYS=7

# ---- WebSocket hardening ----
WS_MAX_PAYLOAD_MB=16
WS_HEARTBEAT_MS=15000
# Comma list; supports chrome-extension://<id> or "chrome-extension://*". Empty = allow all.
WS_ALLOWED_ORIGINS=
# Optional shared secret the extension must send in its auth message. Empty = no auth.
AUTH_TOKEN=

# ---- Misc ----
EVENT_FLUSH_MS=5000
CORS_ORIGIN=*
LOG_LEVEL=info
LOG_PRETTY=true

# ---- Domain binding / access control ----
# Internal users (email in this domain) can record any meeting. Everyone else must supply the key.
ALLOWED_EMAIL_DOMAIN=mybeta.ca
EXTERNAL_ACCESS_KEY=InnoSynth@12
# API key the ERP presents (X-Api-Key header) when registering/removing schedules. SAME value as the
# ERP config (meeting-bot.schedule-api-key).
SCHEDULE_API_KEY=gmr-sched-3fb9c7a15e8d42f6b0a1

# ---- Backend push (ERP webhook) ----
# The recorder PUSHES each finished session here; the ERP stores it + generates the summary.
BACKEND_WEBHOOK_URL=https://erp.lmsmybeta.com/crm/api/schedule/v1/meeting-data/webhook
# Shared secret sent as X-Recorder-Secret; SAME value as the ERP (meeting-bot.webhook.secret).
BACKEND_WEBHOOK_SECRET=gmr-hook-8a2d4e1c9f7b350612cd

# ---- Missed-recording watchdog ----
# Master switch for the missed-recording alert email. true = send; false = don't send.
MISSED_RECORDING_EMAILS_ENABLED=true
MISSED_RECORDING_GRACE_MIN=10
# Only alert within this many minutes AFTER a class start (prevents next-day false alarms).
MISSED_RECORDING_WINDOW_MIN=120
# Never alert for classes that started before the extension cutover (old notetaker era). ISO-8601 UTC.
MISSED_RECORDING_CUTOVER_ISO=2026-07-28T00:00:00Z
WATCHDOG_INTERVAL_MS=60000
# Extra addresses cc'd on every missed-recording alert (comma-separated). Per-class admins can also
# be supplied by the ERP in each schedule registration.
ADMIN_ALERT_EMAILS=programoffice@mybeta.ca

# ---- SMTP (copied from the Base codebase / ERP Constants — AWS SES) ----
SMTP_ENABLED=true
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=AKIAROSUOHV3KYXZ7NU2
SMTP_PASSWORD=BATNEaGVEv/qnVFrXQvf0oXlWqJl646MadLygCH01M7l
SENDER_EMAIL=BETA HIVE <no-reply@mybeta.ca>
