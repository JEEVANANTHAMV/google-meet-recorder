# ---- Server ----
PORT=8001
HOST=0.0.0.0
PUBLIC_BASE_URL=http://your-server-ip:8001

# ---- Storage ----
# gcs (production) | local (dev/testing)
STORAGE_BACKEND=gcs
# GCS bucket names MUST be lowercase, globally unique, and CANNOT contain "google".
GCS_BUCKET_NAME=meet-cloud
GCS_PROJECT_ID=your-gcp-project-id
GCS_LOCATION=ASIA-SOUTH1
GOOGLE_APPLICATION_CREDENTIALS=./Service-Account.json
SIGNED_URL_EXPIRES_DAYS=7

# ---- WebSocket hardening ----
WS_MAX_PAYLOAD_MB=16
WS_HEARTBEAT_MS=15000
# Comma list; supports chrome-extension://<id> or "chrome-extension://*". Empty = allow all.
WS_ALLOWED_ORIGINS=
# Optional shared secret the extension must send in its auth message. Empty = no auth.
AUTH_TOKEN=

# ---- Misc ----
EVENT_FLUSH_MS=5000
CORS_ORIGIN=*
LOG_LEVEL=info
LOG_PRETTY=true

# ---- Domain binding / access control ----
# Internal users (email in this domain) can record any meeting. Everyone else must supply the key.
ALLOWED_EMAIL_DOMAIN=mybeta.ca
EXTERNAL_ACCESS_KEY=InnoSynth@12
# API key the ERP presents (X-Api-Key) when registering/removing schedules (match in ERP config).
SCHEDULE_API_KEY=

# ---- Backend push (ERP webhook) ----
BACKEND_WEBHOOK_URL=https://erp.lmsmybeta.com/crm/api/schedule/v1/meeting-data/webhook
BACKEND_WEBHOOK_SECRET=

# ---- Missed-recording watchdog ----
MISSED_RECORDING_GRACE_MIN=10
WATCHDOG_INTERVAL_MS=60000
ADMIN_ALERT_EMAILS=

# ---- SMTP (transactional email for missed-recording alerts) ----
SMTP_ENABLED=true
SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=BETA HIVE <no-reply@mybeta.ca>
